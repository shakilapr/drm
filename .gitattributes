# Normalization: LF everywhere (Windows is a first-class platform; codebase.md §3.1 R10).
* text=auto eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary

# Generated code: never committed here; suppress diffs if it ever appears locally
**/@generated/** -diff
*.gen.* -diff

# Vendored read-only references: no diffs, no language stats
references/** -diff linguist-vendored
